{
  "meta": {
    "app": "SaveBite",
    "reference": "Too Good To Go (functionality) + Pizza Amici (aesthetic) + Batch/Dribbble (papermorphism)",
    "date": "2026-10-19"
  },
  "color": {
    "roles": {
      "bg":            "#F5F0E8",
      "bg-warm":       "#EDE6DA",
      "surface":       "#FFFDF9",
      "surface-raised":"#FFFFFF",
      "border":        "#D4C9B8",
      "border-input":  "#C2B5A0",
      "text":          "#2B1D15",
      "text-muted":    "#6B5D52",
      "text-subtle":   "#9A8D82",
      "accent":        "#006C5B",
      "accent-hover":  "#005A4B",
      "accent-subtle": "#E6F2EF",
      "on-accent":     "#FFFFFF",
      "secondary":     "#FF8C42",
      "secondary-hover":"#E87A35",
      "on-secondary":  "#FFFFFF",
      "danger":        "#D94040",
      "danger-subtle": "#FFF0F0",
      "success":       "#2E7D32",
      "success-subtle":"#E8F5E9",
      "warning":       "#F9A825",
      "warning-subtle":"#FFF8E1"
    },
    "semantic": {
      "card-bg":       "#FFFDF9",
      "card-shadow":   "rgba(43, 29, 21, 0.08)",
      "overlay":       "rgba(43, 29, 21, 0.5)",
      "shimmer-base":  "#EDE6DA",
      "shimmer-highlight": "#F5F0E8",
      "sold-out-overlay": "rgba(43, 29, 21, 0.35)"
    }
  },
  "typography": {
    "font-display": "Playfair Display",
    "font-body":    "Inter",
    "font-mono":    "Azeret Mono",
    "scale": {
      "xs":   { "size": 11, "lineHeight": 1.45, "weight": 500 },
      "sm":   { "size": 13, "lineHeight": 1.45, "weight": 400 },
      "base": { "size": 15, "lineHeight": 1.55, "weight": 400 },
      "md":   { "size": 17, "lineHeight": 1.45, "weight": 500 },
      "lg":   { "size": 20, "lineHeight": 1.35, "weight": 600 },
      "xl":   { "size": 24, "lineHeight": 1.25, "weight": 700 },
      "2xl":  { "size": 30, "lineHeight": 1.15, "weight": 800 },
      "3xl":  { "size": 40, "lineHeight": 1.1,  "weight": 800 }
    }
  },
  "spacing": {
    "base": 4,
    "scale": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 56, 64, 80, 96, 120]
  },
  "radius": {
    "none": 0,
    "sm":   8,
    "md":   14,
    "lg":   20,
    "xl":   28,
    "pill": 999,
    "card": 24,
    "card-inner": 16
  },
  "shadow": {
    "sm":   "0 2px 8px rgba(43,29,21,0.06)",
    "md":   "0 4px 16px rgba(43,29,21,0.08)",
    "lg":   "0 8px 30px rgba(43,29,21,0.12)",
    "xl":   "0 15px 50px rgba(43,29,21,0.15)",
    "glow-accent": "0 4px 20px rgba(0,108,91,0.25)",
    "glow-secondary": "0 4px 20px rgba(255,140,66,0.3)"
  },
  "motion": {
    "duration": {
      "fast":    150,
      "normal":  300,
      "slow":    500,
      "enter":   400,
      "exit":    250
    },
    "easing": {
      "default":   "cubic-bezier(0.4, 0.0, 0.2, 1)",
      "enter":     "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "exit":      "cubic-bezier(0.4, 0.0, 1, 1)",
      "bounce":    "cubic-bezier(0.175, 0.885, 0.32, 1.275)",
      "spring":    "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "layout": {
    "content-max-width": 428,
    "header-height":     56,
    "bottom-nav-height": 72,
    "card-gap":          16,
    "section-padding":   24,
    "safe-area-bottom":  34
  },
  "pairs": [
    { "name": "body on bg",       "fg": "#2B1D15", "bg": "#F5F0E8" },
    { "name": "muted on bg",      "fg": "#6B5D52", "bg": "#F5F0E8" },
    { "name": "body on surface",   "fg": "#2B1D15", "bg": "#FFFDF9" },
    { "name": "white on accent",   "fg": "#FFFFFF", "bg": "#006C5B" },
    { "name": "white on secondary","fg": "#FFFFFF", "bg": "#FF8C42" },
    { "name": "white on danger",   "fg": "#FFFFFF", "bg": "#D94040" },
    { "name": "accent on subtle",  "fg": "#006C5B", "bg": "#E6F2EF" },
    { "name": "body on card",      "fg": "#2B1D15", "bg": "#FFFDF9" }
  ]
}
